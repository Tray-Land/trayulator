<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trayulator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: same height as the calculator's so the swap doesn't jump  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back (Esc)">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="4,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Calculator" />

                <!--  Settings card pattern without the Toolkit dependency  -->
                <Grid
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Copy result on evaluate" TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Put each result on the clipboard when you press = or Enter."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CopyResultToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Copy result on evaluate"
                        OffContent=""
                        OnContent=""
                        Toggled="CopyResultToggle_Toggled" />
                </Grid>

                <TextBlock
                    Margin="4,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />

                <Grid
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep the tray icon ready after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>

                <TextBlock
                    x:Name="VersionText"
                    Margin="4,16,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
